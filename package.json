{
  "name": "beren",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:bundle && vite",
    "build": "npm run build:bundle && vite build",
    "build:bundle": "node ./scripts/build-bundle.mjs",
    "build:docs": "npm run build:bundle && node ./scripts/build-docs.mjs",
    "pages:prepare": "npm run build:docs",
    "pages:verify": "node ./scripts/verify-pages-static.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "test:e2e": "npm run build:bundle && playwright test",
    "check": "npm run lint && npm run test && npm run build && npm run build:docs"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.51.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "vite": "^7.3.1",
    "vitest": "^2.1.9"
  }
}
